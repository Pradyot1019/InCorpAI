# ---- Required ----------------------------------------------------------------
DATABASE_URL=postgresql://inccorp:inccorp@localhost:5432/inccorp

# ---- Providers (all optional: without keys the app runs fully offline) --------
# Claude for answer generation. Without it, an extractive offline responder is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI embeddings (text-embedding-3-small, 1536-d). Without it, a deterministic
# hashing embedder is used. Re-run `python ingest.py ../corpus` after changing this.
OPENAI_API_KEY=

# Cohere Rerank. Without it: local BGE cross-encoder if installed (pip install '.[local-rerank]'),
# otherwise hybrid-score order.
COHERE_API_KEY=

# ---- Tuning -------------------------------------------------------------------
# Strict negative rejection threshold on the best hybrid score. 0.18 is tuned for the
# offline hash embedder; with OpenAI embeddings start around 0.30 and tune with /api/search.
MIN_RELEVANCE=0.18
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# ---- Security -----------------------------------------------------------------
# JSON list. Lock this to your frontend origin(s) in production.
CORS_ORIGINS=["http://localhost:5173"]
# If set, POST/DELETE /api/documents require header X-Admin-Token.
ADMIN_TOKEN=
